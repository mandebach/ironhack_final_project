  <worksheets>
    <worksheet name='2027 Load-shifting simulation'>
      <table>
        <view>
          <datasources>
            <datasource caption='energy_simulation_master+' name='federated.1o6n4gg15sbsrc15sigtg1254q15' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Dishwasher (1.2 kWh)' caption='Selected Appliance' datatype='string' name='[Parameter 4224176015757317]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dishwasher (1.2 kWh)&quot;'>
              <calculation class='tableau' formula='&quot;Dishwasher (1.2 kWh)&quot;' />
              <aliases>
                <alias key='&quot;Dishwasher (1.2 kWh)&quot;' value='Dishwasher (1.2 kWh)' />
                <alias key='&quot;Tumble dryer (2.5 kWh)&quot;' value='Tumble dryer (2.5 kWh)' />
                <alias key='&quot;Washing machine (0.8 kWh)&quot;' value='Washing machine (0.8 kWh)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o6n4gg15sbsrc15sigtg1254q15'>
            <column caption='Appliance kWh' datatype='real' name='[Calculation_4224176016338950]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4224176015757317]&#10;WHEN &quot;Washing machine (0.8 kWh)&quot; THEN 0.8&#10;WHEN &quot;Dishwasher (1.2 kWh)&quot; THEN 1.2&#10;WHEN &quot;Tumble dryer (2.5 kWh)&quot; THEN 2.5&#10;ELSE 1.0&#10;END' />
            </column>
            <column caption='Baseline appliance cost' datatype='real' name='[Calculation_4224176016580615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;, DATETIME([utc_time])) = 20 AND DATEPART(&apos;minute&apos;, DATETIME([utc_time])) = 0 &#10;THEN [actual_rate] * [Calculation_4224176016338950] &#10;ELSE 0 &#10;END' />
            </column>
            <column caption='Optimized midday cost' datatype='real' name='[Calculation_4224176016715784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;, DATETIME([utc_time])) = 13 AND DATEPART(&apos;minute&apos;, DATETIME([utc_time])) = 0 &#10;THEN &#10;    IF ([power_produced_kw] / 60) &gt;= [Calculation_4224176016338950] &#10;    THEN 0 &#10;    ELSE ([Calculation_4224176016338950] - ([power_produced_kw] / 60)) * [spot_price_eur_kwh] &#10;    END&#10;ELSE 0 &#10;END' />
            </column>
            <column caption='Actual Rate' datatype='real' name='[actual_rate]' role='measure' type='quantitative' />
            <column-instance column='[year_month]' derivation='None' name='[none:year_month:nk]' pivot='key' type='nominal' />
            <column caption='Power Produced Kw' datatype='real' name='[power_produced_kw]' role='measure' type='quantitative' />
            <column caption='Spot Price Eur Kwh' datatype='real' name='[spot_price_eur_kwh]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_4224176016580615]' derivation='Sum' name='[sum:Calculation_4224176016580615:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4224176016715784]' derivation='Sum' name='[sum:Calculation_4224176016715784:qk]' pivot='key' type='quantitative' />
            <column caption='Utc Time' datatype='string' name='[utc_time]' role='dimension' type='nominal' />
            <column caption='Year Month' datatype='string' name='[year_month]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1o6n4gg15sbsrc15sigtg1254q15].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1o6n4gg15sbsrc15sigtg1254q15].[sum:Calculation_4224176016580615:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1o6n4gg15sbsrc15sigtg1254q15].[sum:Calculation_4224176016715784:qk]&quot;' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.1o6n4gg15sbsrc15sigtg1254q15].[none:year_month:nk]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:year_month:nk]' />
              <groupfilter function='member' level='[none:year_month:nk]' member='&quot;2026-10&quot;' />
            </groupfilter>
          </filter>
          <filter class='quantitative' column='[federated.1o6n4gg15sbsrc15sigtg1254q15].[sum:Calculation_4224176016580615:qk]' included-values='non-null' />
          <filter class='quantitative' column='[federated.1o6n4gg15sbsrc15sigtg1254q15].[sum:Calculation_4224176016715784:qk]' included-values='non-null' />
          <slices>
            <column>[federated.1o6n4gg15sbsrc15sigtg1254q15].[:Measure Names]</column>
