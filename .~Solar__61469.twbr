      <aliases enabled='yes' />
      <column caption='Self consumed kWh' datatype='real' name='[Calculation_4224175997415424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([energy_produced_kwh], [energy_consumed_kwh])' />
      </column>
      <column caption='Baseline SCR %' datatype='real' default-format='p0.00%' name='[Calculation_4224175997587457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4224175997415424]) / SUM([energy_produced_kwh])' />
      </column>
      <column caption='Baseline Penalty Costs' datatype='real' default-format='C1043%' name='[Calculation_4224176003739650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [energy_produced_kwh] &gt; [energy_consumed_kwh] &#10;THEN ([energy_produced_kwh] - [energy_consumed_kwh]) * [spot_price_eur_kwh] &#10;ELSE 0 END' />
      </column>
      <column caption='Evening spot price' datatype='real' name='[Calculation_4224176014348291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED DATETRUNC(&apos;day&apos;, DATETIME([utc_time])) : AVG(IF [hour] = 20 THEN [spot_price_eur_kwh] END)}' />
      </column>
      <column caption='Midday spot price' datatype='real' name='[Calculation_4224176014786564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED DATETRUNC(&apos;day&apos;, DATETIME([utc_time])) : AVG(IF [hour] = 13 THEN [spot_price_eur_kwh] END)}' />
      </column>
      <column caption='Appliance kWh' datatype='real' name='[Calculation_4224176016338950]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4224176015757317]&#10;WHEN &quot;Washing machine (0.8 kWh)&quot; THEN 0.8&#10;WHEN &quot;Dishwasher (1.2 kWh)&quot; THEN 1.2&#10;WHEN &quot;Tumble dryer (2.5 kWh)&quot; THEN 2.5&#10;ELSE 1.0&#10;END' />
      </column>
      <column caption='Baseline appliance cost' datatype='real' name='[Calculation_4224176016580615]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;, DATETIME([utc_time])) = 20 AND DATEPART(&apos;minute&apos;, DATETIME([utc_time])) = 0 &#10;THEN [actual_rate] * [Calculation_4224176016338950] &#10;ELSE 0 &#10;END' />
      </column>
      <column caption='Optimized midday cost' datatype='real' name='[Calculation_4224176016715784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;, DATETIME([utc_time])) = 13 AND DATEPART(&apos;minute&apos;, DATETIME([utc_time])) = 0 &#10;THEN &#10;    IF ([power_produced_kw] / 60) &gt;= [Calculation_4224176016338950] &#10;    THEN 0 &#10;    ELSE ([Calculation_4224176016338950] - ([power_produced_kw] / 60)) * [spot_price_eur_kwh] &#10;    END&#10;ELSE 0 &#10;END' />
      </column>
      <column caption='3 appliance baseline cost' datatype='real' name='[Calculation_4224176100179980]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4224176014348291] * (0.8 + 1.2 + 2.5)' />
      </column>
      <column caption='3 appliance optimized cost' datatype='real' name='[Calculation_4224176100601869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4224176014786564] * (0.8 + 1.2 + 2.5)' />
      </column>
      <column caption='Potential savings' datatype='real' default-format='C1043%' name='[Calculation_4224176101203982]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4224176100179980] - [Calculation_4224176100601869]' />
      </column>
