          <datasource-dependencies datasource='federated.1o6n4gg15sbsrc15sigtg1254q15'>
            <column caption='Evening spot price' datatype='real' name='[Calculation_4224176014348291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED DATETRUNC(&apos;day&apos;, DATETIME([utc_time])) : AVG(IF [hour] = 20 THEN [spot_price_eur_kwh] END)}' />
            </column>
            <column caption='Midday spot price' datatype='real' name='[Calculation_4224176014786564]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED DATETRUNC(&apos;day&apos;, DATETIME([utc_time])) : AVG(IF [hour] = 13 THEN [spot_price_eur_kwh] END)}' />
            </column>
            <column caption='3 appliance baseline cost' datatype='real' name='[Calculation_4224176100179980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4224176014348291] * (0.8 + 1.2 + 2.5)' />
            </column>
            <column caption='3 appliance optimized cost' datatype='real' name='[Calculation_4224176100601869]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4224176014786564] * (0.8 + 1.2 + 2.5)' />
            </column>
            <column caption='Potential savings' datatype='real' default-format='C1043%' name='[Calculation_4224176101203982]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4224176100179980] - [Calculation_4224176100601869]' />
